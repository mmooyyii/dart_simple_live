<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:banner="@mipmap/ic_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="Simple Live TV"
        android:largeHeap="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.agreement.LauncherActivity"
            android:banner="@mipmap/ic_banner"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.home.HomeActivity" android:screenOrientation="landscape" />
        <activity android:name=".ui.rooms.RoomListActivity" android:screenOrientation="landscape" />
        <activity android:name=".ui.category.CategoryActivity" android:screenOrientation="landscape" />
        <activity android:name=".ui.search.SearchActivity" android:screenOrientation="landscape" />
        <activity android:name=".ui.history.HistoryActivity" android:screenOrientation="landscape" />
        <activity android:name=".ui.settings.SettingsActivity" android:screenOrientation="landscape" />
        <activity android:name=".ui.sync.SyncActivity" android:screenOrientation="landscape" />
        <activity android:name=".ui.login.BiliLoginActivity" android:screenOrientation="landscape" />
        <activity
            android:name=".ui.live.LiveRoomActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/PlayerTheme" />

        <!-- OTA 更新安装 APK -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.ota_provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ota_file_paths" />
        </provider>
    </application>
</manifest>
